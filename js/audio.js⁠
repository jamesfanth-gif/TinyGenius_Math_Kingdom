/* =========================================================================
   WEB SPEECH API - 精準性別過濾引擎
   ========================================================================= */
let cachedSystemVoices = [];

function refreshSystemVoices() {
  if ('speechSynthesis' in window) {
    cachedSystemVoices = window.speechSynthesis.getVoices();
  }
}

if ('speechSynthesis' in window) {
  window.speechSynthesis.onvoiceschanged = refreshSystemVoices;
  refreshSystemVoices();
}

function findOptimalVoiceForTeacher(profile) {
  if (!cachedSystemVoices || cachedSystemVoices.length === 0) refreshSystemVoices();
  const voices = cachedSystemVoices;
  if (!voices || voices.length === 0) return null;

  const langVoices = voices.filter(v => v.lang && v.lang.toLowerCase().startsWith(profile.lang.toLowerCase().slice(0, 2)));

  const femaleKeywords = ['female', 'zira', 'samantha', 'victoria', 'jenny', 'karen', 'hazel', 'susan', 'serena', 'libby', 'sonia', 'natasha', 'catherine'];
  const maleKeywords = ['male', 'david', 'mark', 'george', 'oliver', 'daniel'];

  for (const pName of profile.preferredNames) {
    const match = langVoices.find(v => v.name.toLowerCase().includes(pName.toLowerCase()));
    if (match) return match;
  }

  if (profile.isFemale) {
    const femaleVoice = langVoices.find(v => {
      const n = v.name.toLowerCase();
      return femaleKeywords.some(kw => n.includes(kw)) && !maleKeywords.some(m => n.includes(m));
    });
    if (femaleVoice) return femaleVoice;
  } else {
    const maleVoice = langVoices.find(v => {
      const n = v.name.toLowerCase();
      return maleKeywords.some(kw => n.includes(kw));
    });
    if (maleVoice) return maleVoice;
  }

  return langVoices[0] || voices[0];
}

function speakEnglishOnly(text, onEndCallback = null) {
  if (!isSoundOn || !('speechSynthesis' in window)) return;
  window.speechSynthesis.cancel();

  const cleanText = text.replace(/[\u4e00-\u9fa5]|[\u3000-\u303f]|[\uff01-\uff60]/g, '')
                        .replace(/[🎈⭐🍓🍎🐶🐱➕➖🟰❓❌👈👉⚖️✂️🦁🐨🐼🌱🌸🚀🏛️🎧🌳🦆🌊🍦🦋🍰💎🛒]/g, '')
                        .trim();
  if (!cleanText) return;

  const currentTeacher = TEACHER_PROFILES[currentTeacherIndex];
  const utterance = new SpeechSynthesisUtterance(cleanText);
  utterance.lang = currentTeacher.lang;
  utterance.rate = currentTeacher.rate;
  utterance.pitch = currentTeacher.pitch;

  const matchedVoice = findOptimalVoiceForTeacher(currentTeacher);
  if (matchedVoice) {
    utterance.voice = matchedVoice;
    if (currentTeacher.isFemale && matchedVoice.name.toLowerCase().includes('male')) {
      const namePill = document.getElementById('currentTeacherNamePill');
      if (namePill) namePill.innerText = 'Mr. Oliver';
    }
  }

  if (onEndCallback) utterance.onend = onEndCallback;
  window.speechSynthesis.speak(utterance);
}

const NUMBER_WORDS_EN = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 
                         'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen', 'Twenty'];

function speakNumberWord(n) {
  const word = NUMBER_WORDS_EN[n] || String(n);
  speakEnglishOnly(word);
}

